{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: g++.exe build active file",
            "command": "cmd.exe",
            "args": [
                "/c",
                "taskkill /im ${fileBasenameNoExtension}.exe /f 2>nul & C:\\msys64\\ucrt64\\bin\\g++.exe -g ${file} -o ${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Compiler task with automatic background process termination."
        }
    ]
}
